{
    "name": "jmoati/icloudpd",
    "description": "Pure PHP port of icloud_photos_downloader (icloudpd): download photos and videos from iCloud without Python",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "The iCloud Photo Downloader Authors",
            "role": "Authors of icloudpd"
        },
        {
            "name": "Jacques Moati",
            "email": "jacques@moati.net",
            "role": "PHP port"
        }
    ],
    "require": {
        "php": ">=8.5",
        "ext-curl": "*",
        "ext-gmp": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "jmoati/image-exiftool": "^13.59"
    },
    "autoload": {
        "psr-4": {
            "Foundation\\": "src/Foundation/",
            "Icloudpd\\": "src/Icloudpd/",
            "PyicloudIpd\\": "src/PyicloudIpd/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/icloudpd",
        "bin/icloud"
    ],
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    }
}
